{
  "name": "counting",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "0-100 in Mandarin, French and German, composed from a small table of lexical atoms",
  "scripts": {
    "table": "node compose.ts table",
    "check": "node compose.ts check",
    "stats": "node compose.ts stats",
    "emit": "node compose.ts emit",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "install:app": "bash ./install.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^7.0.4"
  },
  "engines": {
    "node": ">=23"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.5.0"
  }
}
